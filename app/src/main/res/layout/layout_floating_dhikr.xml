<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- EXPANDED CARD MODE -->
    <LinearLayout
        android:id="@+id/floating_card_container"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_bg_dark_green"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="visible">

        <!-- Top Drag Header & Control Buttons -->
        <LinearLayout
            android:id="@+id/floating_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_floating_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="أَذْكَارُ الصَّبَاحِ 📿"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_floating_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="1 / 3"
                android:textColor="#8FAFA0"
                android:textSize="11sp" />

            <!-- Minimize Button -->
            <TextView
                android:id="@+id/btn_floating_minimize"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="—"
                android:textColor="#94A3B8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Dismiss / Close Button -->
            <TextView
                android:id="@+id/btn_floating_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#EF4444"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dhikr Arabic Text Body -->
        <TextView
            android:id="@+id/tv_floating_arabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="4"
            android:text="أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ، وَالْحَمْدُ لِلَّهِ"
            android:textColor="#EDF8F2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Action Row: Counter + "+1" + "Next" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_floating_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 / 3"
                android:textColor="#34D399"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_floating_count"
                android:layout_width="54dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_btn_emerald"
                android:text="+1"
                android:textColor="#041008"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_floating_next"
                android:layout_width="74dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_btn_inset"
                android:text="التالي ❯"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- MINIMIZED FLOATING BUBBLE MODE -->
    <FrameLayout
        android:id="@+id/floating_bubble_container"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/widget_btn_emerald"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="📿"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tv_bubble_badge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:background="@drawable/widget_btn_inset"
            android:gravity="center"
            android:text="1"
            android:textColor="#34D399"
            android:textSize="9sp"
            android:textStyle="bold" />
    </FrameLayout>

</FrameLayout>
